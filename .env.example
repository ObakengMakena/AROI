# Copy to .env for local runs. On GitHub, add the same names as repository secrets.

# Supabase → Connect → "Session pooler" connection string (works from GitHub Actions, which has no IPv6)
DATABASE_URL=postgresql://postgres.xxxxxxxx:YOUR-PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# openalex.org → create account → Settings → API key (free, $1/day of usage)
OPENALEX_API_KEY=
CONTACT_EMAIL=you@example.com

# platform.claude.com → API keys. Set a spend limit in the Console too.
ANTHROPIC_API_KEY=

# Weekly digest email (Gmail: create an App Password under Google Account → Security)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
DIGEST_TO=you@gmail.com

# --- Optional tuning (defaults shown) ---
# TARGET_COUNTRY=ZA
# SWEEP_FIELDS=11                  # OpenAlex field ids; 11 = Agricultural and Biological Sciences
# TRIAGE_THRESHOLD=6               # 0-10; papers at/above this get full analysis
# ANALYZE_PER_RUN=5
# VALIDATE_PER_RUN=2
# WEB_SEARCHES_PER_VALIDATION=6
# MONTHLY_BUDGET_USD=20            # hard stop for Claude spend
# RUN_BUDGET_USD=2
# DIGEST_MIN_SCORE=55
# USE_FULL_TEXT=true               # GROBID full text from OpenAlex when available ($0.01 each)
