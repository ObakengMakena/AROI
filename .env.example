# Copy to .env for local runs. On GitHub, add the same names as repository secrets.

# Supabase → Connect → "Session pooler" connection string (works from GitHub Actions, which has no IPv6).
# Use the aroi_pipeline role from sql/roles.sql, not the postgres superuser.
DATABASE_URL=postgresql://aroi_pipeline.xxxxxxxx:YOUR-PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# Connection the Grok Bot agents use for `python -m aroi.agent_queue` (aroi_agent role: read + queue only).
# Falls back to DATABASE_URL if unset. Never give the agents the pipeline or superuser password.
AGENT_DATABASE_URL=postgresql://aroi_agent.xxxxxxxx:YOUR-PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
# Name recorded on claimed tasks and stored as the "model" of each analysis/score
AROI_WORKER=grok-bot

# openalex.org → create account → Settings → API key (free, $1/day of usage)
OPENALEX_API_KEY=
CONTACT_EMAIL=you@example.com

# Weekly digest email (Gmail: create an App Password under Google Account → Security)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
DIGEST_TO=you@gmail.com

# --- Optional tuning (defaults shown) ---
# TARGET_COUNTRY=ZA
# SECTORS=agriculture,energy,ai,construction,quant_finance
# DISCOVERY_DATE_FIELD=created_date  # or publication_date (old behaviour: misses back-dated records)
# TRIAGE_THRESHOLD=6               # 0-10; papers at/above this get full analysis
# TRIAGE_MAX_PER_SECTOR=60
# TRIAGE_BATCH_SIZE=15             # papers per triage task
# ANALYZE_PER_SECTOR=5             # analysis tasks queued per sector per tick
# VALIDATE_PER_SECTOR=2            # market validation tasks queued per sector per tick
# TASK_LEASE_MINUTES=120           # a claimed task returns to the queue after this
# TASK_MAX_ATTEMPTS=3              # pulls (or failed ingests) before a task is marked failed
# MIN_QUOTE_CHARS=30               # shorter evidence quotes never count as verified
# MONTHLY_BUDGET_USD=30            # hard stop for OpenAlex spend (incl. $0.01 GROBID full texts)
# HEARTBEAT_MAX_HOURS=36           # digest warns if no pipeline run within this window
# DIGEST_TOP_N_PER_SECTOR=3
# DIGEST_MIN_SCORE=55
# USE_FULL_TEXT=true
